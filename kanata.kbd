(defcfg
  process-unmapped-keys yes
)

(defsrc)

;; -----------------------------------------------------------------------------
;; BASE LAYER
;; -----------------------------------------------------------------------------
(deflayermap (base)
  ;; Tap for Space, hold for Navigation layer (200ms timeout)
  spc (tap-hold 200 200 spc (layer-while-held nav))

  ;; Completely disable the Caps Lock key
  caps XX
)

;; -----------------------------------------------------------------------------
;; NAVIGATION LAYER (Active while holding Spacebar)
;; -----------------------------------------------------------------------------
(deflayermap (nav)
  ;; --- Active Navigation Keys ---
  i up
  j left
  k down
  l rght
  h home
  ; end
  u pgup
  o pgdn
  m del
  n bspc

  tab tab
  lctl lctl
  rctl rctl
  lsft lsft
  rsft rsft 
  enter enter
  lalt lalt
  ralt ralt
  caps enter
   
  ;; --- Word & Line Selection (with 30ms delay) ---
  d (macro C-left 30 C-S-rght)  ;; Select current word
  f (macro home 30 S-end)       ;; Select current line

  ;; --- 1-Key Clipboard / Editing Cluster ---
  z C-z                         ;; Undo
  x C-x                         ;; Cut
  c C-c                         ;; Copy
  v C-v                         ;; Paste
  a C-a                         ;; Select All
  y C-y                         ;; Redo
  s C-s                         ;; Save
  w C-w
  t C-t
  e C-e				;; Hop to search bar
  r C-m				;; Fluent search UI
  q C-lalt			;; Fluent search

  esc esc

  1  f1
  2  f2
  3  f3
  4  f4
  5  f5
  6  f6
  7  f7
  8  f8
  9  f9
  0  f10
  -  f11
  =  f12

  

  __ XX
)
