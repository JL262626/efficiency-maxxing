(defcfg
  process-unmapped-keys yes
)

(defsrc)

;; -----------------------------------------------------------------------------
;; BASE LAYER
;; -----------------------------------------------------------------------------
(deflayermap (base)
  ;; Tap for Space, hold for Navigation layer (200ms timeout)
  spc (tap-hold 200 200 spc (layer-while-held nav))

  ;; Completely disable the Caps Lock key
  caps XX
)

;; -----------------------------------------------------------------------------
;; NAVIGATION LAYER (Active while holding Spacebar)
;; -----------------------------------------------------------------------------
(deflayermap (nav)
  ;; --- Active Navigation Keys ---
  i up
  j left
  k down
  l rght
  h home
  ; end
  u pgup
  o pgdn
  n bspc
  m del

  ;; --- Word & Line Selection (with 30ms delay) ---
  d (macro C-left 30 C-S-rght)  ;; Select current word
  f (macro home 30 S-end)       ;; Select current line

  ;; --- 1-Key Clipboard / Editing Cluster ---
  z C-z                         ;; Undo
  x C-x                         ;; Cut
  c C-c                         ;; Copy
  v C-v                         ;; Paste
  a C-a                         ;; Select All
  y C-y                         ;; Redo
  s C-s                         ;; Save

  ;; --- Muted Letter Keys ---
  q XX  w XX  e XX  r XX  t XX  p XX  [ XX  ] XX  \ XX
  g XX  ' XX
  b XX  , XX  . XX  / XX

  ;; --- Muted Number Row ---
  grv XX  1 XX  2 XX  3 XX  4 XX  5 XX  6 XX  7 XX  8 XX  9 XX  0 XX  - XX  = XX
)